-- botón genérico
local function mkButton(parent, text, size, pos, textSize)
	local b = new("TextButton", {
		Text = text, Font = FONT, TextSize = textSize or 12, TextColor3 = C.white,
		BackgroundColor3 = C.panel, AutoButtonColor = false, Size = size, Position = pos or UDim2.new(),
	}, parent)
	corner(b)
	local s = stroke(b, C.white, 0.6, 1)
	b.MouseButton1Down:Connect(function() s.Transparency = 0 end)
	b.MouseButton1Up:Connect(function() s.Transparency = 0.6 end)
	b.MouseLeave:Connect(function() s.Transparency = 0.6 end)
	return b
end

local function mkLabel(parent, text, size, color, pos, sz, align)
	return new("TextLabel", {
		BackgroundTransparency = 1, Text = text, Font = FONT, TextSize = size or 12, TextColor3 = color or C.white,
		TextXAlignment = align or Enum.TextXAlignment.Left, Position = pos or UDim2.new(),
		Size = sz or UDim2.fromScale(1, 1), TextWrapped = true,
	}, parent)
end

-- interruptor [ ON ] / [ OFF ]
local function mkSwitch(parent, initial, cb)
	local b = mkButton(parent, "", UDim2.fromOffset(64, 24), UDim2.new(1, -64, 0.5, -12))
	local state = initial
	local function paint()
		b.Text = state and "[ ON ]" or "[ OFF ]"
		b.BackgroundColor3 = state and C.white or C.panel
		b.TextColor3 = state and C.bg or C.white
	end
	b.MouseButton1Click:Connect(function()
		state = not state
		paint()
		cb(state)
	end)
	paint()
	return { get = function() return state end }
end

-- PALANCA con destello blanco de 100+ capas
local function mkLever(parent, layers, cb)
	local box = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(64, 64) }, parent)

	local glow = new("CanvasGroup", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(150, 150), GroupTransparency = 1, ZIndex = 1,
	}, box)
	local gscale = new("UIScale", { Scale = 1 }, glow)
	for i = 1, layers do
		local d = 22 + (i / layers) * 120
		local l = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(d, d), BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.992, BorderSizePixel = 0,
		}, glow)
		corner(l, 999)
	end

	local base = new("Frame", {
		BackgroundColor3 = C.bg, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(32, 54),
		Size = UDim2.fromOffset(30, 10), ZIndex = 3, BorderSizePixel = 0,
	}, box)
	corner(base, 2)
	stroke(base, C.white, 0.1, 1)

	local stick = new("Frame", {
		BackgroundColor3 = C.white, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(32, 52),
		Size = UDim2.fromOffset(4, 32), Rotation = -38, BorderSizePixel = 0, ZIndex = 4,
	}, box)
	stroke(stick, C.bg, 0, 1)
	local knob = new("Frame", {
		BackgroundColor3 = C.white, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(14, 14), BorderSizePixel = 0, ZIndex = 5,
	}, stick)
	corner(knob, 999)
	stroke(knob, C.bg, 0, 2)

	local hit = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 6 }, box)

	local state, pulse, token = false, nil, 0
	local function set(on)
		state = on
		token += 1
		local my = token
		if pulse then pulse:Cancel() pulse = nil end
		TweenService:Create(stick, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Rotation = on and 38 or -38 }):Play()
		if on then
			-- destello: aparece fuerte y se asienta
			glow.GroupTransparency = 0
			gscale.Scale = 0.4
			TweenService:Create(gscale, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
				{ Scale = 1 }):Play()
			local settle = TweenService:Create(glow, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ GroupTransparency = 0.3 })
			settle.Completed:Connect(function(st)
				if my == token and state and st == Enum.PlaybackState.Completed then
					pulse = TweenService:Create(glow, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
						{ GroupTransparency = 0.55 })
					pulse:Play()
				end
			end)
			settle:Play()
		else
			TweenService:Create(glow, TweenInfo.new(0.3), { GroupTransparency = 1 }):Play()
			TweenService:Create(gscale, TweenInfo.new(0.3), { Scale = 0.6 }):Play()
		end
	end
	hit.MouseButton1Click:Connect(function()
		set(not state)
		cb(state)
	end)
	return box
end

-- slider (la cámara se bloquea mientras lo arrastras)
local function mkSlider(parent, minV, maxV, init, fmt, cb)
	local f = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, parent)
	local lbl = mkLabel(f, "", 11, C.gray, UDim2.new(), UDim2.new(1, 0, 0, 14))
	local track = new("Frame", {
		BackgroundColor3 = C.line, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 26), Size = UDim2.new(1, 0, 0, 4),
	}, f)
	corner(track, 2)
	local fill = new("Frame", { BackgroundColor3 = C.white, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) }, track)
	corner(fill, 2)
	local knob = new("Frame", {
		BackgroundColor3 = C.white, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 18), Position = UDim2.fromScale(0, 0.5),
	}, track)
	corner(knob, 2)
	stroke(knob, C.bg, 0, 2)
	local hit = new("TextButton", {
		Text = "", BackgroundTransparency = 1, Position = UDim2.new(0, -8, 0, 12), Size = UDim2.new(1, 16, 0, 32),
	}, f)

	local value = init
	local enabled = true
	local function render()
		local a = (value - minV) / (maxV - minV)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.fromScale(a, 0.5)
		lbl.Text = fmt(value)
	end
	local function setFromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		value = math.floor(minV + a * (maxV - minV) + 0.5)
		render()
		cb(value)
	end

	local dragging, dragInput = false, nil
	hit.InputBegan:Connect(function(input)
		if not enabled then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, dragInput = true, input
			lockCamera(true)
			setFromX(input.Position.X)
		end
	end)
	bind(UIS.InputChanged, function(input)
		if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
			setFromX(input.Position.X)
		end
	end)
	bind(UIS.InputEnded, function(input)
		if dragging and (input == dragInput
			or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			dragging = false
			lockCamera(false)
		end
	end)
	render()
	return {
		setEnabled = function(on)
			enabled = on
			fill.BackgroundColor3 = on and C.white or C.line
			knob.BackgroundColor3 = on and C.white or C.gray
			lbl.TextColor3 = on and C.gray or C.line
		end,
	}
end

