local sethp = sethiddenproperty or set_hidden_property or set_hidden_prop
local function claimSim()
	pcall(function()
		LocalPlayer.ReplicationFocus = workspace
		if sethp then
			sethp(LocalPlayer, "SimulationRadius", math.huge)
		else
			LocalPlayer.SimulationRadius = math.huge
		end
	end)
end

local function getRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local holder = new("Folder", { Name = "SR6" }, workspace)
local target = new("Part", {
	Name = "Target", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
	Transparency = 1, Size = Vector3.new(1, 1, 1),
}, holder)
local tAtt = new("Attachment", {}, target)

-- rayo azul suave (núcleo + halo)
local function makeBeam(width, t0, t1)
	return new("Beam", {
		Color = ColorSequence.new(C.blue),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, t0), NumberSequenceKeypoint.new(0.5, (t0 + t1) / 2),
			NumberSequenceKeypoint.new(1, t1),
		}),
		Width0 = width, Width1 = width, FaceCamera = true, LightEmission = 1, Segments = 1, Enabled = false,
	}, holder)
end
local beamCore = makeBeam(0.12, 0.8, 0.35)
local beamHalo = makeBeam(0.6, 0.95, 0.88)

local function inCharacter(part)
	local m = part.Parent
	while m and m ~= workspace do
		if m:FindFirstChildOfClass("Humanoid") then return true end
		m = m.Parent
	end
	return false
end

local function isLoose(part)
	return part:IsA("BasePart") and not part.Anchored and part:IsDescendantOf(workspace)
		and not part:IsDescendantOf(holder) and not inCharacter(part)
end

local function rootAtt()
	local root = getRoot()
	if not root then return nil end
	local a = root:FindFirstChild("SR6Att")
	if not a then a = new("Attachment", { Name = "SR6Att" }, root) end
	return a
end

local function setStatus(text, hint)
	if statusLbl then statusLbl.Text = text end
	if padHint then padHint.Text = hint or (held and "ARRASTRA AQUI PARA MOVER" or "TOCA UN OBJETO\n(MITAD IZQUIERDA)") end
end

------------------------------------------------------------------
-- Cámara (se bloquea mientras usas el slider)
------------------------------------------------------------------
local camLock
local function lockCamera(on)
	local cam = workspace.CurrentCamera
	if not cam then return end
	if on then
		if camLock then return end
		camLock = { t = cam.CameraType }
		cam.CameraType = Enum.CameraType.Scriptable
	elseif camLock then
		cam.CameraType = camLock.t
		camLock = nil
	end
end

------------------------------------------------------------------
-- Gravedad del objeto
------------------------------------------------------------------
local function getRec(part)
	local r = mods[part]
	if not r then
		r = { cc = part.CanCollide }
		mods[part] = r
	end
	return r
end

local function applyGravity(part)
	if not part or not part.Parent then return end
	local rec = getRec(part)
	local mult = gravOn and (gravLevel / 100) or 0
	if math.abs(mult - 1) < 0.01 then
		if rec.force then rec.force:Destroy() rec.force = nil end
		if rec.gatt then rec.gatt:Destroy() rec.gatt = nil end
		return
	end
	if not rec.force then
		rec.gatt = new("Attachment", { Name = "SR6Grav" }, part)
		rec.force = new("VectorForce", {
			Attachment0 = rec.gatt, RelativeTo = Enum.ActuatorRelativeTo.World, ApplyAtCenterOfMass = true,
		}, part)
	end
	rec.force.Force = Vector3.new(0, part.AssemblyMass * workspace.Gravity * (1 - mult), 0)
end

local function restoreMods()
	for part, rec in pairs(mods) do
		pcall(function()
			if rec.force then rec.force:Destroy() end
			if rec.gatt then rec.gatt:Destroy() end
			if part.Parent and rec.cc ~= nil and not (held and held.part == part) then
				part.CanCollide = rec.cc
			end
		end)
	end
	mods = {}
end

------------------------------------------------------------------
-- Agarrar objeto
------------------------------------------------------------------
local function release()
	if not held then return end
	local h = held
	held = nil
	for _, o in ipairs({ h.ap, h.ao, h.grip, h.hl }) do
		pcall(function() o:Destroy() end)
	end
	local rec = mods[h.part]
	if h.part.Parent and rec and rec.cc ~= nil then h.part.CanCollide = rec.cc end
	if rec and not rec.force then mods[h.part] = nil end
	beamCore.Enabled, beamHalo.Enabled = false, false
	beamCore.Attachment1, beamHalo.Attachment1 = nil, nil
	if cross then cross.Visible = false end
	setStatus("OBJETO: ninguno")
end

local function grab(part)
	release()
	if not isLoose(part) then return end
	claimSim()
	getRec(part)
	local grip = new("Attachment", { Name = "SR6Grip" }, part)
	target.CFrame = part.CFrame
	local ap = new("AlignPosition", {
		Mode = Enum.PositionAlignmentMode.TwoAttachment, Attachment0 = grip, Attachment1 = tAtt,
		MaxForce = math.huge, MaxVelocity = math.huge, Responsiveness = 60, RigidityEnabled = false,
	}, part)
	local ao = new("AlignOrientation", {
		Mode = Enum.OrientationAlignmentMode.TwoAttachment, Attachment0 = grip, Attachment1 = tAtt,
		MaxTorque = math.huge, Responsiveness = 40, RigidityEnabled = false,
	}, part)
	local hl = new("Highlight", {
		Adornee = part, FillColor = C.blue, FillTransparency = 0.8,
		OutlineColor = C.blue, OutlineTransparency = 0.2,
	}, holder)
	part.CanCollide = false
	part.AssemblyLinearVelocity = Vector3.zero
	held = { part = part, grip = grip, ap = ap, ao = ao, hl = hl }
	beamCore.Attachment1, beamHalo.Attachment1 = grip, grip
	beamCore.Enabled, beamHalo.Enabled = true, true
	applyGravity(part)
	setStatus("OBJETO: " .. part.Name)
end

local function pick(pos)
	local cam = workspace.CurrentCamera
	if not cam then return end
	local ray = cam:ScreenPointToRay(pos.X, pos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ex = { holder }
	if LocalPlayer.Character then ex[#ex + 1] = LocalPlayer.Character end
	params.FilterDescendantsInstances = ex
	local res = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
	if not res then return end
	if isLoose(res.Instance) then
		grab(res.Instance)
	else
		setStatus("NO MOVIBLE: " .. res.Instance.Name)
	end
end

local function movePad(delta)
	if not held then return end
	local cam = workspace.CurrentCamera
	local cf = cam.CFrame
	local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
	right = right.Magnitude > 0.01 and right.Unit or Vector3.xAxis
	local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	look = look.Magnitude > 0.01 and look.Unit or Vector3.zAxis * -1
	local dist = (cf.Position - target.Position).Magnitude
	local k = 0.05 * math.clamp(dist / 15, 0.6, 5)
	local move = right * (delta.X * k)
	if padMode == "plano" then
		move = move + look * (-delta.Y * k)
	else
		move = move + Vector3.new(0, -delta.Y * k, 0)
	end
	local newPos = target.Position + move
	local root = getRoot()
	if root and (newPos - root.Position).Magnitude > 300 then
		newPos = root.Position + (newPos - root.Position).Unit * 300
	end
	target.Position = newPos
end

