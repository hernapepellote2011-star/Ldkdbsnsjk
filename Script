-- Ring Parts
------------------------------------------------------------------
local ringSaved, ringConn = {}, nil

local function ringAdd(p)
	if ringSaved[p] == nil and isLoose(p) then
		ringSaved[p] = { props = p.CustomPhysicalProperties, cc = p.CanCollide }
		p.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
		p.CanCollide = false
	end
end

local function setRing(on)
	ringOn = on
	if on then
		claimSim()
		for _, d in ipairs(workspace:GetDescendants()) do ringAdd(d) end
		ringConn = workspace.DescendantAdded:Connect(ringAdd)
	else
		if ringConn then ringConn:Disconnect() ringConn = nil end
		for p, s in pairs(ringSaved) do
			if p.Parent then
				p.CustomPhysicalProperties = s.props
				p.CanCollide = s.cc
			end
		end
		ringSaved = {}
	end
end

