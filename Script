------------------------------------------------------------------
-- Entradas: tocar para seleccionar (izquierda) y arrastrar (derecha)
------------------------------------------------------------------
local taps = {}
bind(UIS.InputBegan, function(input, gp)
	if gp or not grabOn then return end
	local t = input.UserInputType
	if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then return end
	if input.Position.X >= gui.AbsoluteSize.X * 0.5 then return end
	taps[input] = { p = input.Position, t = os.clock() }
end)

local padInput
pad.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		padInput = input
	end
end)

bind(UIS.InputChanged, function(input)
	if padInput and held then
		if input == padInput
			or (padInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement) then
			movePad(input.Delta)
		end
	end
end)

bind(UIS.InputEnded, function(input)
	if input == padInput
		or (padInput and padInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
		padInput = nil
	end
	local s = taps[input]
	taps[input] = nil
	if s and grabOn and (input.Position - s.p).Magnitude < 14 and os.clock() - s.t < 0.4 then
		pick(Vector2.new(input.Position.X, input.Position.Y))
	end
end)

------------------------------------------------------------------
-- Bucle principal
------------------------------------------------------------------
bind(RunService.Heartbeat, function()
	if ringOn or held or next(mods) then claimSim() end

	if held and not held.part.Parent then release() end

	if ringOn then
		local root = getRoot()
		if root then
			local c = root.Position
			for p in pairs(ringSaved) do
				if not p.Parent then
					ringSaved[p] = nil
				elseif not p.Anchored and not (held and held.part == p) then
					local pos = p.Position
					local dist = (Vector3.new(pos.X, c.Y, pos.Z) - c).Magnitude
					local ang = math.atan2(pos.Z - c.Z, pos.X - c.X) + math.rad(rotSpeed)
					local r = math.min(radius, dist)
					local tp = Vector3.new(
						c.X + math.cos(ang) * r,
						c.Y + height * math.abs(math.sin((pos.Y - c.Y) / height)),
						c.Z + math.sin(ang) * r
					)
					local d = tp - pos
					if d.Magnitude > 0.05 then p.AssemblyLinearVelocity = d.Unit * attraction end
				end
			end
		end
	end
end)

bind(RunService.RenderStepped, function()
	local cam = workspace.CurrentCamera
	if held and held.part.Parent and cam then
		local ra = rootAtt()
		if ra then
			beamCore.Attachment0 = ra
			beamHalo.Attachment0 = ra
		end
		local p, on = cam:WorldToScreenPoint(held.part.Position)
		cross.Visible = on
		if on then
			cross.Position = UDim2.fromOffset(p.X, p.Y)
			local s = 30 + math.sin(os.clock() * 4) * 3
			crossRing.Size = UDim2.fromOffset(s, s)
		end
	elseif cross then
		cross.Visible = false
	end
end)

