local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r or R) }, o) end
local function stroke(o, color, transp, thick)
	return new("UIStroke", { Color = color or C.white, Transparency = transp or 0.6, Thickness = thick or 1 }, o)
end

